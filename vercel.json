{
  "version": 2,
  "name": "zoonoab-agent",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VOICE_ASR_PROVIDER": "deepseek",
    "VOICE_TRANSCRIBE_MODEL": "deepseek-v4-flash"
  }
}
